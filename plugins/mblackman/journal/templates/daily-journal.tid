title: $:/plugins/mblackman/journal/ui/templates/daily-journal
type: text/vnd.tiddlywiki

\whitespace trim
\import [[$:/plugins/mblackman/journal/macros]]

<$let
  currentTiddler={{{ [<storyTiddler>!is[blank]else<currentTiddler>] }}}
  storyOrCurrent=<<currentTiddler>>
  prettyDate={{{ [<currentTiddler>dayjs[dddd, MMMM D, YYYY]] }}}
  weekTitle={{{ [{!!week}!is[blank]] ~[<currentTiddler>dayjs[iso-week]] }}}
  prevWeekTitle={{{ [<currentTiddler>dayjs:shift[-1,week,iso-week]] }}}
  monthTag={{{ [{!!month}!is[blank]] ~[<currentTiddler>dayjs[YYYY-MM]] }}}
  prevMonthTag={{{ [<currentTiddler>dayjs:shift[-1,month,YYYY-MM]] }}}
  yearTag={{{ [{!!year}!is[blank]] ~[<currentTiddler>dayjs[YYYY]] }}}
  weekJournalDate={{{ [{!!journal-date}!is[blank]] ~[<currentTiddler>dayjs[YYYYMMDD120000000]] }}}
  dayCompact={{{ [<currentTiddler>dayjs[YYYYMMDD]] }}}
  tags={{{ [[Journal]] [[Weekly]] [<monthTag>] [<yearTag>] +[join[ ]] }}}
  activeWeekFocus={{{ [<weekTitle>get[improvement-highlight]!is[blank]] ~[<prevWeekTitle>get[improvement-highlight]!is[blank]] }}}
  activeWeekSource={{{ [<weekTitle>get[improvement-highlight]!is[blank]then<weekTitle>] ~[<prevWeekTitle>get[improvement-highlight]!is[blank]then<prevWeekTitle>] }}}
  activeMonthPriorities={{{ [<monthTag>get[monthly-priorities]!is[blank]] ~[<prevMonthTag>get[monthly-priorities]!is[blank]] }}}
  activeMonthSource={{{ [<monthTag>get[monthly-priorities]!is[blank]then<monthTag>] ~[<prevMonthTag>get[monthly-priorities]!is[blank]then<prevMonthTag>] }}}
  onThisDayTitles={{{ [<currentTiddler>onthisday[]] }}}
  activityTiddlers={{{ [all[tiddlers]!is[system]!tag[Journal]sameday:created<weekJournalDate>] [all[tiddlers]!is[system]!tag[Journal]sameday:modified<weekJournalDate>] [<currentTiddler>backlinks[]!is[system]!tag[Journal]] [<currentTiddler>tagging[]!is[system]!tag[Journal]] +[unique[]sort[title]] }}}
>

<div class="journal-entry-container">

<$list filter="[<prettyDate>!is[blank]]" variable="ignore">
  <div class="journal-editorial-subtitle"><$text text=<<prettyDate>>/></div>
</$list>

<<journal-nav "Daily" """
  <<journal-parent-btn target=<<weekTitle>> label=<<weekTitle>> tags=<<tags>> tooltip="Open Weekly Review" year=<<yearTag>> month=<<monthTag>> journalDate=<<weekJournalDate>> >>
""" """
  <$journal-period-grid mode="weekly" period=<<weekTitle>> active=<<currentTiddler>> />
""">>

<$list filter="[<activeWeekFocus>!is[blank]] [<activeMonthPriorities>!is[blank]] +[limit[1]]" variable="ignore">
  <div class="journal-focus-banner">
    <$list filter="[<activeWeekFocus>!is[blank]]" variable="ignore">
      <div class="journal-focus-row">
        <span class="journal-focus-label">Weekly Focus (<$link to=<<activeWeekSource>>><$text text=<<activeWeekSource>>/></$link>):</span>
        <span class="journal-focus-text"><$text text=<<activeWeekFocus>>/></span>
      </div>
    </$list>
    <$list filter="[<activeMonthPriorities>!is[blank]]" variable="ignore">
      <div class="journal-focus-row">
        <span class="journal-focus-label">Monthly Priorities (<$link to=<<activeMonthSource>>><$text text=<<activeMonthSource>>/></$link>):</span>
        <div class="journal-focus-text"><$transclude $tiddler=<<activeMonthSource>> $field="monthly-priorities" $mode="block"/></div>
      </div>
    </$list>
  </div>
</$list>

<h3 class="journal-section-heading">Habits & Logs</h3>
<div class="journal-habits-container">
  <$journal-habits />
  <$list filter="[[$:/config/Journal/EnableMedia]get[text]else[yes]!match[no]] :filter[[$:/plugins/mblackman/media-importer]!is[missing]]" variable="ignore">
    <div class="journal-span-2 habit-card-item">
      <div class="habit-label-row">
        <span class="habit-label">Media Logged Today</span>
      </div>
      <$MediaPicker date=<<currentTiddler>> />
    </div>
  </$list>
</div>

<h3 class="journal-section-heading">Reflection</h3>

<div class="journal-section journal-card-panel">
  <div class="journal-section-tight">
    <span class="journal-label">Big Win</span>
    <$edit-text field="highlight" class="tc-edit-texteditor journal-input" placeholder="One sentence summary for roll-ups..." />
  </div>
  <$transclude $variable="journal-log-section" field="wins-log" label="" placeholder="Type a win and hit Enter..." sublabel="Detailed Wins" />
</div>

<div class="journal-section journal-card-panel">
  <$transclude $variable="journal-log-section" field="gratitude-log" label="Gratitude List" placeholder="I am grateful for..." sublabel="" />
</div>

<div class="journal-section journal-card-panel">
  <div class="journal-section-tight">
    <span class="journal-label">Main Challenge</span>
    <$edit-text field="lowlight" class="tc-edit-texteditor journal-input" placeholder="One sentence summary..." />
  </div>
  <$transclude $variable="journal-log-section" field="challenges-log" label="" placeholder="Type a challenge and hit Enter..." sublabel="Detailed Challenges" />
</div>

<$list filter="[(onThisDayTitles)!is[blank]limit[1]]" variable="ignore">
  <hr class="journal-hr">
  <h3 class="journal-section-heading">On This Day</h3>
  <div class="journal-on-this-day-list">
    <$list filter="[(onThisDayTitles)]" variable="otdTiddler">
      <$tiddler tiddler=<<otdTiddler>>>
        <$let otdBadge={{{ [<otdTiddler>onthisday:label<storyOrCurrent>] }}}>
          <div class="journal-otd-card">
            <div class="journal-otd-header">
              <div class="journal-otd-title-group">
                <span class="journal-otd-badge"><$text text=<<otdBadge>>/></span>
                <$link to=<<otdTiddler>>><strong><$text text={{{ [<otdTiddler>dayjs[ddd, DD MMM YYYY]] }}}/></strong></$link>
              </div>
              <div class="journal-day-card-habits">
                <$habit-dots />
              </div>
            </div>
            <$list filter="[all[current]has[highlight]]">
              <div class="journal-roll-up-row">
                <span class="journal-roll-up-tag journal-roll-up-tag-win">Win</span>
                <span>{{!!highlight}}</span>
              </div>
            </$list>
            <$list filter="[all[current]has[lowlight]]">
              <div class="journal-roll-up-row">
                <span class="journal-roll-up-tag journal-roll-up-tag-challenge">Challenge</span>
                <span>{{!!lowlight}}</span>
              </div>
            </$list>
          </div>
        </$let>
      </$tiddler>
    </$list>
  </div>
</$list>

<$list filter="[(activityTiddlers)!is[blank]limit[1]]" variable="ignore">
  <hr class="journal-hr">
  <h3 class="journal-section-heading">Wiki Activity & Mentions</h3>
  <div class="journal-activity-list">
    <$list filter="[(activityTiddlers)]" variable="actTiddler">
      <div class="journal-activity-item">
        <$link to=<<actTiddler>>><$text text=<<actTiddler>>/></$link>
        <div class="journal-activity-badges">
          <$list filter="[<storyOrCurrent>backlinks[]match<actTiddler>]" variable="ignore">
            <span class="journal-activity-badge">Mentioned</span>
          </$list>
          <$list filter="[<storyOrCurrent>tagging[]match<actTiddler>]" variable="ignore">
            <span class="journal-activity-badge">Tagged</span>
          </$list>
          <$list filter="[<actTiddler>sameday:created<weekJournalDate>]" variable="ignore">
            <span class="journal-activity-badge">Created</span>
          </$list>
          <$list filter="[<actTiddler>sameday:modified<weekJournalDate>]" variable="ignore">
            <span class="journal-activity-badge">Modified</span>
          </$list>
        </div>
      </div>
    </$list>
  </div>
</$list>

<hr class="journal-hr">

<div class="journal-notes-header-block">
  <div class="journal-notes-title-row">
    <h3 class="journal-section-heading journal-no-margin">Daily Notes</h3>
    <span class="journal-sublabel journal-no-margin">General notes & stream of thought</span>
  </div>
  <$transclude $variable="journal-quick-thought" targetDate=<<currentTiddler>> placeholder="Jot a timestamped note to the bottom of this entry..." />
</div>

</div>
</$let>
