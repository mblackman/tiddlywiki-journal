title: $:/plugins/mblackman/journal/macros
tags: $:/tags/Macro
type: text/vnd.tiddlywiki

\whitespace trim

\procedure journal-nav(period, upButton, gridBlock)
<$let
  prevTiddler={{{ [tag[Journal]tag<period>sort[title]before<currentTiddler>] }}}
  nextTiddler={{{ [tag[Journal]tag<period>sort[title]after<currentTiddler>] }}}
  todayStr={{{ [[now]dayjs[YYYY-MM-DD]] }}}
>
<div class="journal-nav">
  <div class="journal-nav-top">
    <% if [<prevTiddler>!is[blank]] %>
      <$button class="tc-btn-invisible journal-btn" tooltip={{{ [[Previous ]] [<period>] [[: ]] [<prevTiddler>] +[join[]] }}}>
        <$action-navigate $to=<<prevTiddler>>/>
        ← Prev
      </$button>
    <% else %>
      <span class="journal-btn journal-btn-disabled" title={{{ [[No earlier ]] [<period>] [[ entry]] +[join[]] }}}>← Prev</span>
    <% endif %>
    <div class="journal-nav-center">
      <$transclude $variable="upButton" $mode="inline"/>
    </div>
    <div class="journal-nav-right">
      <% if [<period>match[Daily]!is[blank]] %>
        <% if [<currentTiddler>!match<todayStr>] %>
          <$button class="tc-btn-invisible journal-btn journal-btn-sm journal-btn-today-jump" tooltip={{{ [[Jump to today (]] [<todayStr>] [[)]] +[join[]] }}}>
            <$let
              weekTag={{{ [<todayStr>dayjs[iso-week]] }}}
              monthTag={{{ [<todayStr>dayjs[YYYY-MM]] }}}
              yearTag={{{ [<todayStr>dayjs[YYYY]] }}}
              dayJournalDate={{{ [<todayStr>dayjs[YYYYMMDD120000000]] }}}
              dailyTags={{{ [[Journal]] [[Daily]] [<weekTag>] [<monthTag>] [<yearTag>] +[join[ ]] }}}
            >
              <$list filter="[<todayStr>!is[tiddler]]" variable="none">
                <$action-setfield $tiddler=<<todayStr>> tags=<<dailyTags>> journal-date=<<dayJournalDate>> year=<<yearTag>> month=<<monthTag>> week=<<weekTag>>/>
              </$list>
              <$action-navigate $to=<<todayStr>>/>
            </$let>
            Today
          </$button>
        <% endif %>
      <% endif %>
      <% if [<nextTiddler>!is[blank]] %>
        <$button class="tc-btn-invisible journal-btn" tooltip={{{ [[Next ]] [<period>] [[: ]] [<nextTiddler>] +[join[]] }}}>
          <$action-navigate $to=<<nextTiddler>>/>
          Next →
        </$button>
      <% else %>
        <span class="journal-btn journal-btn-disabled" title={{{ [[No newer ]] [<period>] [[ entry]] +[join[]] }}}>Next →</span>
      <% endif %>
    </div>
  </div>
  <% if [<gridBlock>!is[blank]] %>
    <div class="journal-nav-grid">
      <$transclude $variable="gridBlock" $mode="block"/>
    </div>
  <% endif %>
</div>
</$let>
\end

\procedure journal-parent-btn(target, label, tags, tooltip, year, month, week, journalDate, class:"journal-btn")
<$list filter="[<target>!is[blank]]" variable="ignore">
<$button class={{{ [[tc-btn-invisible ]] [<class>] +[join[]] }}} tooltip=<<tooltip>>>
  <$list filter="[<target>!is[tiddler]]" variable="ignore">
    <$action-setfield $tiddler=<<target>> tags=<<tags>> />
  </$list>
  <$list filter="[<year>!is[blank]] :filter[<target>get[year]is[blank]]" variable="ignore">
    <$action-setfield $tiddler=<<target>> year=<<year>> />
  </$list>
  <$list filter="[<month>!is[blank]] :filter[<target>get[month]is[blank]]" variable="ignore">
    <$action-setfield $tiddler=<<target>> month=<<month>> />
  </$list>
  <$list filter="[<week>!is[blank]] :filter[<target>get[week]is[blank]]" variable="ignore">
    <$action-setfield $tiddler=<<target>> week=<<week>> />
  </$list>
  <$list filter="[<journalDate>!is[blank]] :filter[<target>get[journal-date]is[blank]]" variable="ignore">
    <$action-setfield $tiddler=<<target>> journal-date=<<journalDate>> />
  </$list>
  <$action-navigate $to=<<target>> />
  <$text text={{{ [[↑ ]] [<label>] +[join[]] }}}/>
</$button>
</$list>
\end

\procedure journal-quick-add-actions()
<$let entry={{{ [<tempTiddler>get[text]trim[]] }}}>
  <$list filter="[<entry>!is[blank]]" variable="ignore">
    <$action-setfield $field=<<field>> $value={{{ [<currentTiddler>get<field>!is[blank]addsuffix<newline>] [<entry>addprefix[* ]] +[join[]] }}} />
    <$action-setfield $tiddler=<<tempTiddler>> text="" />
  </$list>
</$let>
\end

\procedure journal-quick-add(field, placeholder)
<$let
  tempTiddler={{{ [[$:/temp/journal/quickadd/]] [<currentTiddler>] [[/]] [<field>] +[join[]] }}}
  newline={{{ [charcode[10]] }}}
>
  <div class="journal-flex-row journal-quick-add-row">
    <div class="journal-flex-grow">
      <$keyboard key="enter" class="journal-full-width" actions=<<journal-quick-add-actions>>>
        <$edit-text tiddler=<<tempTiddler>> tag="input" class="journal-input journal-quick-input" placeholder=<<placeholder>> default="" />
      </$keyboard>
    </div>
    <$button class="tc-btn-invisible journal-btn journal-btn-primary" tooltip="Add Bullet" actions=<<journal-quick-add-actions>>>
      Add
    </$button>
  </div>
</$let>
\end

\procedure journal-log-section(field, label, placeholder, sublabel)
<$let
  editState={{{ [[$:/state/journal/edit/]] [<currentTiddler>] [[/]] [<field>] +[join[]] }}}
  isEditing={{{ [<editState>get[text]match[yes]then[yes]else[no]] }}}
>
  <div class="journal-log-block">
    <div class="journal-log-header-row">
      <div class="journal-log-titles">
        <% if [<label>!is[blank]] %>
          <span class="journal-label"><$text text=<<label>>/></span>
        <% endif %>
        <% if [<sublabel>!is[blank]] %>
          <span class="journal-sublabel"><$text text=<<sublabel>>/></span>
        <% endif %>
      </div>
      <% if [<currentTiddler>get<field>trim[]!is[blank]] [<isEditing>match[yes]] +[limit[1]] %>
        <$button class="tc-btn-invisible journal-btn-ghost-sm" tooltip={{{ [<isEditing>match[yes]then[Finish editing raw list]else[Edit list items]] }}}>
          <% if [<isEditing>match[yes]] %>
            <$action-deletetiddler $tiddler=<<editState>>/>
            Done
          <% else %>
            <$action-setfield $tiddler=<<editState>> text="yes"/>
            Edit
          <% endif %>
        </$button>
      <% endif %>
    </div>

    <% if [<currentTiddler>get<field>trim[]!is[blank]] %>
      <% if [<isEditing>!match[yes]] %>
        <div class="journal-log-rendered">
          <$transclude $tiddler=<<currentTiddler>> $field=<<field>> $mode="block"/>
        </div>
      <% endif %>
    <% endif %>

    <$transclude $variable="journal-quick-add" field=<<field>> placeholder=<<placeholder>> />

    <% if [<isEditing>match[yes]] %>
      <div class="journal-log-raw-editor">
        <$edit-text field=<<field>> class="tc-edit-texteditor journal-input" tag="textarea" min-height="80px" placeholder="One * bullet item per line..." />
      </div>
    <% endif %>
  </div>
</$let>
\end

\procedure journal-quick-thought-actions()
<$let
  thoughtText={{{ [<tempThought>get[text]trim[]] }}}
  timeStamp={{{ [[now]dayjs[HH:mm]] }}}
  formattedLine={{{ [[* '']] [<timeStamp>] [['' — ]] [<thoughtText>] +[join[]] }}}
  existingText={{{ [<thoughtDate>get[text]trim[]] }}}
  weekTag={{{ [<thoughtDate>dayjs[iso-week]] }}}
  monthTag={{{ [<thoughtDate>dayjs[YYYY-MM]] }}}
  yearTag={{{ [<thoughtDate>dayjs[YYYY]] }}}
  dayJournalDate={{{ [<thoughtDate>dayjs[YYYYMMDD120000000]] }}}
  dailyTags={{{ [[Journal]] [[Daily]] [<weekTag>] [<monthTag>] [<yearTag>] +[join[ ]] }}}
>
  <$list filter="[<thoughtText>!is[blank]]" variable="ignore">
    <$list filter="[<thoughtDate>!is[tiddler]]" variable="none">
      <$action-setfield $tiddler=<<thoughtDate>> tags=<<dailyTags>> journal-date=<<dayJournalDate>> year=<<yearTag>> month=<<monthTag>> week=<<weekTag>>/>
    </$list>
    <$action-setfield $tiddler=<<thoughtDate>> $field="text" $value={{{ [<existingText>!is[blank]addsuffix<newline>] [<formattedLine>] +[join[]] }}} />
    <$action-setfield $tiddler=<<tempThought>> text="" />
  </$list>
</$let>
\end

\procedure journal-quick-thought(targetDate, placeholder:"Jot a quick timestamped thought to today's notes...")
<$let
  thoughtDate={{{ [<targetDate>!is[blank]else<currentTiddler>] }}}
  tempThought={{{ [[$:/temp/journal/thought/]] [<thoughtDate>] +[join[]] }}}
  newline={{{ [charcode[10]] }}}
  doubleNewline={{{ [charcode[10]addsuffix<newline>] }}}
>
  <div class="journal-quick-thought-bar">
    <div class="journal-flex-row">
      <div class="journal-flex-grow">
        <$keyboard key="enter" class="journal-full-width" actions=<<journal-quick-thought-actions>>>
          <$edit-text tiddler=<<tempThought>> tag="input" class="journal-input journal-quick-input" placeholder=<<placeholder>> default="" />
        </$keyboard>
      </div>
      <$button class="tc-btn-invisible journal-btn journal-btn-primary" tooltip="Append timestamped note" actions=<<journal-quick-thought-actions>>>
        Jot
      </$button>
    </div>
  </div>
</$let>
\end
